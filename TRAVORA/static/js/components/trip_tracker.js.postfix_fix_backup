  `;
}

// Interactive Leaflet Map for Live Tracker
window.initTrackerMap = function (tour, items = [], activeIdx = 0) {
  const mapEl = document.getElementById('tracker-leaflet-map');
  if (!mapEl || !window.L) return;

  if (trackerLeafletMap) {
    trackerLeafletMap.remove();
    trackerLeafletMap = null;
  }

  const baseLat = (items[activeIdx] && items[activeIdx].lat) ? items[activeIdx].lat : (tour.destination_lat || 15.5494);
  const baseLng = (items[activeIdx] && items[activeIdx].lng) ? items[activeIdx].lng : (tour.destination_lng || 73.7535);

  trackerLeafletMap = window.L.map('tracker-leaflet-map', {
    zoomControl: true,
    attributionControl: false
  }).setView([baseLat, baseLng], 13);

  // Modern CartoDB / OSM clean tiles
  window.L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 18
  }).addTo(trackerLeafletMap);

  const points = [];

  // Plot milestone stops
  items.forEach((it, idx) => {
    const lat = it.lat || (baseLat + (idx * 0.012));
    const lng = it.lng || (baseLng + (idx * 0.010));
    points.push([lat, lng]);

    const isCurrent = idx === activeIdx;
    const isCompleted = idx < activeIdx;

    if (isCurrent) {
      // VEHICLE RADAR MARKER
      const vehicleHtml = `
        <div class="vehicle-radar-marker">
          <div class="marker-radar-wave"></div>
          <div class="marker-icon-box">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"></path>
            </svg>
          </div>
        </div>
      `;
      const icon = window.L.divIcon({
        className: 'custom-vehicle-radar',
        html: vehicleHtml,
        iconSize: [44, 44],
        iconAnchor: [22, 22]
      });
      trackerVehicleMarker = window.L.marker([lat, lng], { icon: icon }).addTo(trackerLeafletMap);
      trackerVehicleMarker.bindPopup(`
        <div class="p-1 text-xs">
          <strong class="text-teal-600 block text-sm">Active Stop #${idx + 1}: ${it.title}</strong>
          <span class="text-slate-500">${it.location_name || 'En Route'} - Speed: 48 km/h</span>
        </div>
      `).openPopup();
    } else {
      // Standard Stop Marker
      const stopHtml = `
        <div class="stop-pin-marker ${isCompleted ? 'completed' : ''}">
          ${isCompleted ? '<svg class="w-3.5 h-3.5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>' : idx + 1}
        </div>
      `;
      const icon = window.L.divIcon({
        className: 'custom-stop-marker',
        html: stopHtml,
        iconSize: [28, 28],
        iconAnchor: [14, 14]
      });
      const marker = window.L.marker([lat, lng], { icon: icon }).addTo(trackerLeafletMap);
      marker.bindPopup(`
        <div class="p-1 text-xs">
          <strong class="block">${it.title}</strong>
          <span class="text-slate-400">${it.time_start} - ${it.time_end}</span>
        </div>
      `);
    }
  });

  if (points.length > 1) {
    const route = window.L.polyline(points, {
      color: '#0d9488',
      weight: 4,
      opacity: 0.85,
      dashArray: '8, 8'
    }).addTo(trackerLeafletMap);
    trackerLeafletMap.fitBounds(route.getBounds(), { padding: [40, 40] });
  }
};

window.advanceTrackerSimulatedStop = function (totalStops) {
  if (typeof window.trackerSimulatedStopIndex === 'undefined') {
    window.trackerSimulatedStopIndex = 1;
  }
  window.trackerSimulatedStopIndex = (window.trackerSimulatedStopIndex + 1) % totalStops;
  store.setState({});
  store.addToast(`Vehicle dispatched to Milestone #${window.trackerSimulatedStopIndex + 1}!`, 'success');
};

window.selectSimulatedMilestone = function (idx) {
  window.trackerSimulatedStopIndex = idx;
  store.setState({});
  store.addToast(`Focused on Milestone #${idx + 1}`, 'info');
};

