                      <i data-lucide="receipt" class="w-3.5 h-3.5"></i>
                      <span>View Tax Invoice</span>
                    </button>
                  </div>
                }`}
              </div>

            </div>
          ` : activeTab === 'trips' ? }`
            <!-- TAB 3: SAVED ITINERARIES -->
            <div class="space-y-4">
              <div class="flex items-center justify-between pb-1 border-b border-slate-200 dark:border-slate-800">
