        <div class="lg:hidden border-t border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-950/95 px-4 pt-3 pb-5 space-y-2 animate-fadeIn">
          
          <div class="flex items-center justify-between pb-2 mb-1 border-b border-slate-100 dark:border-slate-800">
            <span class="inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase border ${roleConfig.color}">
              <span class="w-1.5 h-1.5 rounded-full ${roleConfig.dot}"></span>
              <span>${roleConfig.label}</span>
            </span>
            <span class="text-xs text-slate-400">${userName}</span>
          </div>

          <button 
            onclick="window.navigateView('dashboard'); window.toggleMobileNav();" 
            class="w-full text-left px-3.5 py-2.5 rounded-xl font-bold text-xs flex items-center space-x-2.5 ${state.currentView === 'dashboard' ? 'bg-teal-500/10 text-teal-600' : 'text-slate-700 dark:text-slate-300'}">
            <i data-lucide="home" class="w-4 h-4 text-teal-500"></i>
            <span>Dashboard</span>
          </button>

          <button 
            onclick="window.startExploreDistricts(); window.toggleMobileNav();" 
            class="w-full text-left px-3.5 py-2.5 rounded-xl font-bold text-xs flex items-center space-x-2.5 text-slate-700 dark:text-slate-300">
            <i data-lucide="compass" class="w-4 h-4 text-teal-500"></i>
            <span>Explore 802 Indian Districts</span>
          </button>

          <button 
            onclick="window.navigateView('planner'); window.toggleMobileNav();" 
            class="w-full text-left px-3.5 py-2.5 rounded-xl font-extrabold text-xs flex items-center space-x-2.5 bg-gradient-to-r from-teal-500/15 to-emerald-500/15 text-teal-700 dark:text-teal-300 border border-teal-500/30">
            <i data-lucide="sparkles" class="w-4 h-4 text-teal-500"></i>
            <span>Plan Journey</span>
          </button>

          <button 
            onclick="window.navigateView('itinerary'); window.toggleMobileNav();" 
            class="w-full text-left px-3.5 py-2.5 rounded-xl font-bold text-xs flex items-center space-x-2.5 ${state.currentView === 'itinerary' ? 'bg-teal-500/10 text-teal-600' : 'text-slate-700 dark:text-slate-300'}">
            <i data-lucide="calendar" class="w-4 h-4 text-teal-500"></i>
            <span>My Trips</span>
          </button>

          <button 
            onclick="window.navigateView('tracker'); window.toggleMobileNav();" 
            class="w-full text-left px-3.5 py-2.5 rounded-xl font-bold text-xs flex items-center space-x-2.5 ${state.currentView === 'tracker' ? 'bg-teal-500/10 text-teal-600' : 'text-slate-700 dark:text-slate-300'}">
            <i data-lucide="navigation" class="w-4 h-4 text-emerald-500"></i>
            <span>Live Tracker (Live on Tour)</span>
          </button>

          <button 
            onclick="window.openProfileModal(); window.toggleMobileNav();" 
            class="w-full text-left px-3.5 py-2.5 rounded-xl font-bold text-xs flex items-center space-x-2.5 text-slate-700 dark:text-slate-300">
            <i data-lucide="user" class="w-4 h-4 text-teal-500"></i>
            <span>My Account & Receipts</span>
          </button>

          <button 
            onclick="window.navigateView('about'); window.toggleMobileNav();" 
            class="w-full text-left px-3.5 py-2.5 rounded-xl font-bold text-xs flex items-center space-x-2.5 text-slate-700 dark:text-slate-300">
            <i data-lucide="info" class="w-4 h-4 text-teal-500"></i>
            <span>About TRAVORA</span>
          </button>

        </div>
      ` : ''}

    </header>
  `;
}

// Global UI Navigation Helpers
window.toggleMobileNav = function () {
  window.isMobileNavOpen = !window.isMobileNavOpen;
  store.setState({});
};

window.startExploreDistricts = function () {
  window.navigateView('planner');
  window.plannerState.isDistrictSelectorOpen = true;
  if (!window.plannerState.loadedDistrictsList || window.plannerState.loadedDistrictsList.length === 0) {
    if (window.toggleDistrictSelector) {
      window.toggleDistrictSelector();
      return;
    }
  }
  store.setState({});
  setTimeout(() => {
    const el = document.getElementById('district-search-input');
    if (el) {
      el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      el.focus();
    }
  }, 120);
};

window.switchYatraServiceTab = function (tab) {
  window.landingSearchTab = tab;
  store.setState({ landingSearchTab: tab });
  const state = store.getState();
  if (state.currentView !== 'landing') {
    window.navigateView('landing');
  }
  setTimeout(() => {
    window.scrollTo({ top: 120, behavior: 'smooth' });
  }, 100);
};
