export function renderOperatorDetailModal(operator) {
  if (!operator) return '';

  return `
    <div id="operator-detail-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-md transition-all duration-300">
      
      <div class="relative w-full max-w-xl surface-card bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-2xl space-y-6 max-h-[90vh] overflow-y-auto">
        
        <!-- CLOSE BUTTON -->
        <button 
          type="button" 
          onclick="window.closeOperatorDetailModal()" 
          class="absolute top-5 right-5 w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center transition text-lg font-bold">
          &times;
        </button>

        <!-- HEADER -->
        <div class="flex items-start space-x-4 pr-8">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-teal-500 via-amber-500 to-emerald-500 p-[2px] shadow-lg shrink-0">
            <div class="w-full h-full rounded-[14px] bg-slate-950 text-white flex items-center justify-center font-black text-lg">
              ${operator.name.split(' ').map(n=>n[0]).join('').slice(0,2)}
            </div>
          </div>
          <div>
            <div class="flex items-center space-x-2">
              <h3 class="text-xl font-extrabold text-slate-900 dark:text-white">
                ${operator.name}
              </h3>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-teal-500/15 text-teal-700 dark:text-teal-300 border border-teal-500/30">
                ${operator.badge || 'Verified Partner'}
              </span>
            </div>
            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 mt-0.5">
              ${operator.company_name}
            </p>
          </div>
        </div>

        <!-- KEY STATS GRID -->
        <div class="grid grid-cols-3 gap-2 bg-slate-50 dark:bg-slate-950/60 p-3 rounded-2xl border border-slate-200 dark:border-slate-800 text-center">
          <div>
            <div class="text-base font-black text-amber-500 flex items-center justify-center space-x-1">
              <i data-lucide="star" class="w-3.5 h-3.5 fill-amber-500 text-amber-500"></i>
              <span>${operator.rating || 4.9}</span>
            </div>
            <div class="text-[10px] text-slate-400 font-medium">Customer Rating</div>
          </div>
          <div class="border-x border-slate-200 dark:border-slate-800">
            <div class="text-base font-black text-slate-900 dark:text-white">
              ${operator.tours_completed || 150}+
            </div>
            <div class="text-[10px] text-slate-400 font-medium">Tours Executed</div>
          </div>
          <div>
            <div class="text-base font-black text-teal-600 dark:text-teal-400 flex items-center justify-center space-x-1">
              <i data-lucide="zap" class="w-3 h-3 text-teal-500"></i>
              <span>${operator.response_time_minutes || 4}m</span>
            </div>
            <div class="text-[10px] text-slate-400 font-medium">Dispatch Speed</div>
          </div>
        </div>

        <!-- AI MATCH RATIONALE -->
        <div class="p-3.5 rounded-2xl bg-teal-500/5 dark:bg-teal-950/30 border border-teal-500/20 text-xs space-y-1.5">
          <div class="font-bold text-teal-700 dark:text-teal-300 flex items-center space-x-1.5">
            <i data-lucide="sparkles" class="w-4 h-4 text-amber-500"></i>
            <span>AI Compatibility Match: ${operator.match_score || 95}%</span>
          </div>
          <p class="text-[11px] text-slate-600 dark:text-slate-400 leading-relaxed">
            ${operator.ai_recommendation_reason || 'Highly compatible verified local partner with localized fleet availability and 24/7 on-ground emergency dispatch.'}
          </p>
        </div>

        <!-- FLEET & OPERATING REGIONS -->
        <div class="space-y-3 text-xs">
          <div class="space-y-1">
            <span class="font-bold text-slate-700 dark:text-slate-300">Dedicated Fleet & Gear:</span>
            <div class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 font-medium flex items-center space-x-2">
              <i data-lucide="truck" class="w-4 h-4 text-amber-500 shrink-0"></i>
              <span>${operator.fleet_size || '12 Multi-Axle Volvo Coaches, Speedboats & AC Vans'}</span>
            </div>
          </div>

          <div class="space-y-1">
            <span class="font-bold text-slate-700 dark:text-slate-300">Primary Operating Destinations:</span>
            <div class="flex flex-wrap gap-1.5 pt-0.5">
              ${(Array.isArray(operator.operating_destinations) ? operator.operating_destinations : (operator.operating_destinations || 'Goa, Jaipur').split(',')).map(d => }`
                <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-[11px] font-medium flex items-center space-x-1">
                  <i data-lucide="map-pin" class="w-3 h-3 text-teal-500"></i>
                  <span>${d.trim()}</span>
                </span>
              `).join('')}
            </div>
          </div>

          <div class="space-y-1">
            <span class="font-bold text-slate-700 dark:text-slate-300">Specialties:</span>
            <div class="flex flex-wrap gap-1.5 pt-0.5">
              ${(Array.isArray(operator.specialties) ? operator.specialties : (operator.specialties || 'Beach, Watersports, Heritage').split(',')).map(s => }`
                <span class="px-2.5 py-1 rounded-lg bg-teal-500/10 text-teal-600 dark:text-teal-400 text-[11px] font-medium border border-teal-500/20">
                  ${s.trim()}
                </span>
              `).join('')}
            </div>
          </div>

          <div class="space-y-1">
            <span class="font-bold text-slate-700 dark:text-slate-300">About the Operator:</span>
            <p class="text-[11px] text-slate-600 dark:text-slate-400 leading-relaxed">
              ${operator.bio || 'Leading travel coordinator providing seamless on-ground transit, personalized guides, and instant adaptation to real-time travel disruptions.'}
            </p>
          </div>
        </div>

        <!-- SELECT OPERATOR ACTION -->
        <div class="pt-3 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between gap-3">
          <button 
            type="button" 
            onclick="window.closeOperatorDetailModal()" 
            class="px-5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-300 font-bold text-xs hover:bg-slate-100 dark:hover:bg-slate-800 transition">
            Close
          </button>
          <button 
            type="button" 
            onclick="window.selectPlannerOperator(${operator.id}); window.closeOperatorDetailModal();" 
            class="px-6 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-500 text-white font-extrabold text-xs shadow-md shadow-teal-500/20 transition flex items-center space-x-1.5">
            <i data-lucide="check-circle" class="w-4 h-4"></i>
            <span>Choose ${operator.name.split(' ')[0]} as My Operator</span>
          </button>
        </div>

      </div>

    </div>
  `;
}
