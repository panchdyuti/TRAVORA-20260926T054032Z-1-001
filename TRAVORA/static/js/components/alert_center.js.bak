import { store } from '../store.js';

export function renderAlertCenter() {
  const state = store.getState();
  const alerts = state.operatorAlerts || [];
  const currentTab = state.alertFilterTab || 'active'; // 'active', 'resolved', 'all'

  const pendingAlerts = alerts.filter(a => a.status === 'pending');
  const resolvedAlerts = alerts.filter(a => a.status === 'resolved');

  const displayedAlerts = currentTab === 'active' 
    ? pendingAlerts 
    : (currentTab === 'resolved' ? resolvedAlerts : alerts);

  return `
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
      
      <!-- HEADER -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200 dark:border-slate-800">
        <div>
          <div class="text-xs font-bold text-teal-600 dark:text-teal-400 uppercase tracking-wider flex items-center space-x-1.5">
            <i data-lucide="shield-alert" class="w-4 h-4"></i>
            <span>Real-Time Disruption Monitoring</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">
            Operations Alert Feed
          </h1>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
            Real-time supply chain collision alerts, hotel lock detections, and automated AI resolution options.
          </p>
        </div>

        <!-- REFRESH STATUS -->
        <div class="flex items-center space-x-3">
          <button 
            onclick="window.refreshAlertsFeed()" 
            class="px-4 py-2 rounded-xl surface-card hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold text-xs border border-slate-300 dark:border-slate-700 transition flex items-center space-x-1.5">
            <i data-lucide="refresh-cw" class="w-3.5 h-3.5 text-teal-500"></i>
            <span>Sync Live Feed</span>
          </button>
        </div>
      </div>

      <!-- FILTER TABS -->
      <div class="flex items-center space-x-2 border-b border-slate-200 dark:border-slate-800 pb-3 text-xs font-bold">
        <button 
          onclick="window.setAlertFilterTab('active')"
          class="px-4 py-2 rounded-xl transition flex items-center space-x-1.5 ${currentTab === 'active' ? 'bg-red-600 text-white shadow-md' : 'surface-card text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}">
          <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i>
          <span>Active Pending (${pendingAlerts.length})</span>
        </button>

        <button 
          onclick="window.setAlertFilterTab('resolved')"
          class="px-4 py-2 rounded-xl transition flex items-center space-x-1.5 ${currentTab === 'resolved' ? 'bg-emerald-600 text-white shadow-md' : 'surface-card text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}">
          <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
          <span>Resolved Archive (${resolvedAlerts.length})</span>
        </button>

        <button 
          onclick="window.setAlertFilterTab('all')"
          class="px-4 py-2 rounded-xl transition flex items-center space-x-1.5 ${currentTab === 'all' ? 'bg-teal-600 text-white shadow-md' : 'surface-card text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}">
          <i data-lucide="layers" class="w-3.5 h-3.5"></i>
          <span>All Events (${alerts.length})</span>
        </button>
      </div>

      <!-- ALERTS LIST OR EMPTY STATE -->
      ${displayedAlerts.length === 0 ? }`
        <div class="p-12 surface-card rounded-3xl border border-dashed border-slate-300 dark:border-slate-700 text-center space-y-4">
          <div class="w-14 h-14 mx-auto rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
            <i data-lucide="shield-check" class="w-7 h-7"></i>
          </div>
          <div class="space-y-1">
            <h3 class="text-base font-extrabold text-slate-900 dark:text-white">
              ${currentTab === 'active' ? 'All Clear! No Active Pending Alerts' : 'No Alerts in this Category'}
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 max-w-md mx-auto">
              ${currentTab === 'active' 
                ? 'All traveler itineraries and supply chain dependencies are operating normally with 100% synchronization.' 
                : 'Resolved historical events will appear here once disruptions are cleared.'}
            </p>
          </div>
        </div>
      ` : }`
        <div class="space-y-4">
          ${displayedAlerts.map(a => `
            <div class="surface-card rounded-2xl p-5 border ${a.status === 'resolved' ? 'border-emerald-200 dark:border-emerald-900/40 bg-emerald-50/10 dark:bg-emerald-950/10' : (a.severity === 'critical' ? 'border-red-200 dark:border-red-900/60 bg-red-50/20 dark:bg-red-950/20' : 'border-amber-200 dark:border-amber-900/60')} shadow-md space-y-3 transition">
              
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div class="flex items-center space-x-3">
                  <div class="w-9 h-9 rounded-xl ${a.status === 'resolved' ? 'bg-emerald-500 text-white' : (a.severity === 'critical' ? 'bg-red-500 text-white' : 'bg-amber-500 text-slate-950')} flex items-center justify-center font-bold shrink-0">
                    <i data-lucide="${a.status === 'resolved' ? 'check-circle' : (a.severity === 'critical' ? 'alert-octagon' : 'alert-triangle')}" class="w-5 h-5"></i>
                  </div>
                  <div>
                    <div class="flex items-center space-x-2">
                      <span class="font-mono text-xs font-bold text-teal-600 dark:text-teal-400">#${a.tour_code}</span>
                      <span class="text-xs font-bold text-slate-700 dark:text-slate-300">- ${a.customer_name}</span>
                      <span class="px-2 py-0.5 rounded text-[10px] font-extrabold uppercase ${a.status === 'resolved' ? 'bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30' : 'badge-critical'}">
                        ${a.status === 'resolved' ? 'RESOLVED & SYNCED' : 'PENDING RESOLUTION'}
                      </span>
                    </div>
                    <h3 class="font-extrabold text-sm sm:text-base text-slate-900 dark:text-white mt-0.5">
                      ${a.title}
                    </h3>
                  </div>
                </div>

                <div class="text-left sm:text-right">
                  <div class="text-xs font-bold text-slate-800 dark:text-slate-200">
                    ${a.cost_delta > 0 ? '+Rs ' + a.cost_delta : (a.cost_delta < 0 ? '-Rs ' + Math.abs(a.cost_delta) : 'Rs 0 Impact')}
                  </div>
                  <div class="text-[10px] text-slate-400 font-mono">${a.status === 'resolved' ? 'Cost Balanced' : 'Financial Delta'}</div>
                </div>
              </div>

              <div class="text-xs text-slate-600 dark:text-slate-300 bg-white/60 dark:bg-slate-900/60 p-3 rounded-xl border border-slate-200/80 dark:border-slate-800">
                <span class="font-bold text-slate-700 dark:text-slate-300">Impact Analysis: </span>${a.impact_summary}
              </div>

              <div class="flex items-center justify-between pt-1">
                <div class="text-[10px] text-slate-400">
                  ${a.created_at ? 'Logged: ' + a.created_at.slice(0, 19).replace('T', ' ') : ''}
                </div>

                <div class="flex items-center space-x-2">
                  <button 
                    onclick="window.inspectTourDetail(${a.tour_id || 1})" 
                    class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                    Inspect Tour
                  </button>
                  
                  ${a.status !== 'resolved' ? }`
                    <button 
                      onclick="window.openDisruptionModal(${a.tour_id || 1}, ${a.id})" 
                      class="px-4 py-1.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold text-xs shadow transition flex items-center space-x-1.5">
                      <i data-lucide="wrench" class="w-3.5 h-3.5"></i>
                      <span>Review & Resolve</span>
                    </button>
                  ` : }`
                    <div class="flex items-center space-x-1.5 text-xs font-bold text-emerald-600 dark:text-emerald-400 px-3 py-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20">
                      <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
                      <span>No Action Needed</span>
                    </div>
                  `}
                </div>
              </div>

            </div>
          `).join('')}
        </div>
      `}

    </div>
  `;
}
